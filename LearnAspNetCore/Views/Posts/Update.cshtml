@model LearnAspNetCore.Models.PostUpdateViewModel

<style>
    .form-update{
        width:50%;
    }
    .col-action{
        width: 75px;
    }
    .form-delete{
        display: inline-block;
    }
</style>

<h1 class="uk-title">Database Update</h1>

@if (Model.SelectedPost != null)
{
    <h3 class="uk-title">Update Post</h3>
    <form class="uk-form-stacked form-update" method="POST" asp-controller="Posts" asp-action="Update" asp-route-seq="@Model.SelectedPost.Seq">
        <div>
            <label class="uk-form-label">Name</label>
            <div class="uk-form-controls">
                <input class="uk-input" type="text" name="title" value="@Model.SelectedPost.Title" />
                <i class="uk-text-danger">@Model.TitleMessage</i>
            </div>
        </div>
        <div>
            <label class="uk-form-label">Content</label>
            <div class="uk-form-controls">
                <textarea class="uk-textarea" type="text" name="content">@Model.SelectedPost.Content</textarea>
                <i class="uk-text-danger">@Model.ContentMessage</i>
            </div>
        </div>
        <div>
            <label class="uk-form-label">Status</label>
            <div class="uk-form-controls">
                @foreach (var statusOption in Model.StatusOptions)
                {
                    if (statusOption == Model.SelectedPost.Status)
                    {
                        <label><input class="uk-radio" type="radio" name="status" value="@statusOption" checked> @statusOption</label><br>
                    }
                    else
                    {
                        <label><input class="uk-radio" type="radio" name="status" value="@statusOption"> @statusOption</label><br>
                    }
                }
            </div>
        </div>
        <div class="uk-margin">
            <input type="hidden" name="seq" value="@Model.SelectedPost.Seq" />
            <input type="submit" name="submit" class="uk-button uk-button-primary" value="Update">
            <a asp-controller="Posts" asp-action="Update" class="uk-button uk-button-secondary">Cancel</a>
            <i class="uk-text-success">@Model.SubmitMessage</i>
        </div>
    </form>
}

<div uk-grid>
    <div class="uk-width-2-3">
        <h3 class="uk-title">List of Posts</h3>
        <table class="uk-table uk-table-divider">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Content</th>
                    <th>Status</th>
                    <th class="col-action"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.Posts)
                {
                    <tr>
                        <td><a asp-controller="Posts" asp-action="Update" asp-route-seq="@post.Seq">@post.Title</a></td>
                        <td>@post.Content</td>
                        <td>@post.Status</td>
                        <td>
                            <a asp-controller="Posts" asp-action="Update" asp-route-seq="@post.Seq" class="uk-icon-link" uk-icon="icon: file-edit" title="edit post" uk-tooltip></a>
                            <form class="form-delete" method="POST" asp-controller="Posts" asp-action="Update" asp-route-seq="@post.Seq">
                                <input type="hidden" name="seq" value="@post.Seq" />
                                <input type="hidden" name="submit" value="Delete">
                                <button class="uk-icon-link" uk-icon="icon: close" title="delete post" uk-tooltip></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="uk-width-1-3">
        <h3 class="uk-title">Deleted Posts</h3>
        <table class="uk-table uk-table-divider">
            <thead>
                <tr>
                    <th>Title</th>
                    <th class="col-action"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.DeletedPosts)
                {
                    <tr>
                        <td><a asp-controller="Posts" asp-action="Update" asp-route-seq="@post.Seq">@post.Title</a></td>
                        <td>
                            <form class="form-delete" method="POST" asp-controller="Posts" asp-action="Update" asp-route-seq="@post.Seq">
                                <input type="hidden" name="seq" value="@post.Seq" />
                                <input type="hidden" name="submit" value="Restore">
                                <button class="uk-icon-link" uk-icon="icon: refresh" title="restore post" uk-tooltip></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
